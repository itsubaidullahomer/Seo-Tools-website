# Copy to .env.local for local development. On Vercel, add these in Project → Settings → Environment Variables.

# Brand + canonical domain (no trailing slash). Change these when you buy the domain.
NEXT_PUBLIC_SITE_NAME=ToolkitJar
NEXT_PUBLIC_SITE_URL=https://toolkitjar.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@toolkitjar.com
NEXT_PUBLIC_AUTHOR_NAME=Ubaidullah

# Optional social links
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GITHUB_URL=

# Google Analytics 4 measurement ID (analytics loads only when set)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (optional; DNS verification also works)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Leave EMPTY until AdSense approves the site. When set, the AdSense script loads and ad slots render.
NEXT_PUBLIC_ADSENSE_CLIENT=
